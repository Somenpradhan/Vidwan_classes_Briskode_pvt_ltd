# FastAPI App Settings
PROJECT_NAME="Vidwan Classes API"
API_V1_STR="/api/v1"
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Config
HOST="0.0.0.0"
PORT=8000

# CORS Settings (comma-separated origins allowed to access backend API)
FRONTEND_URL="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:8000"

# Database Settings (SQLite for local dev if postgres not set, PostgreSQL for prod)
# Format for PostgreSQL: postgresql://postgres:password@localhost:5432/vidwan_db
DATABASE_URL="sqlite:///./vidwan.db"

# SMTP Email Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
ADMIN_EMAIL="admin@vidwanclasses.com"
FROM_EMAIL="noreply@vidwanclasses.com"

# Media Storage Provider ("local", "cloudinary", "supabase", "s3")
STORAGE_PROVIDER="local"
STORAGE_BUCKET="vidwan-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_URL_PREFIX=""
